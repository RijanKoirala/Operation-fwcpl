# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build Outputs
dist/
build/
backend/dist/
frontend/dist/

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE PASSWORDS)
.env
.env.local
.env.*.local

# Database and SQLite data
data/
backend/data/*.sqlite
backend/data/*.sqlite-journal
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm

# Uploaded media and customer files
uploads/
backend/uploads/*
!backend/uploads/.gitkeep

# Backups & dumps
backups/
*.tar.gz
*.sql.gz
*.dump

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
zsh
