{
  "name": "fwcpl-backend",
  "version": "1.0.0",
  "description": "Backend API for FWCPL Operations Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "node dist/seeds/runSeed.js",
    "seed:dev": "ts-node src/seeds/runSeed.ts",
    "test:acceptance": "node dist/tests/acceptance.test.js",
    "test:acceptance:dev": "ts-node src/tests/acceptance.test.ts",
    "test:targets": "node dist/tests/targetConnectionSync.test.js",
    "test:targets:dev": "ts-node src/tests/targetConnectionSync.test.ts",
    "test:email": "node dist/tests/testEmail.js",
    "test:email:dev": "ts-node src/tests/testEmail.ts",
    "set:password": "node dist/scripts/setSuperadminPassword.js",
    "set:password:dev": "ts-node src/scripts/setSuperadminPassword.ts",
    "clean:demo": "node dist/scripts/cleanDemoData.js",
    "clean:demo:dev": "ts-node src/scripts/cleanDemoData.ts",
    "send:backup:email": "node dist/scripts/sendBackupEmail.js",
    "send:backup:email:dev": "ts-node src/scripts/sendBackupEmail.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "better-sqlite3": "^9.4.3",
    "nodemailer": "^6.9.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.5",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
